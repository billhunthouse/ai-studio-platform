{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "AI Test Platform — Precision Workspace",
    "status": "proposed-for-figma",
    "version": "0.1.0",
    "source": "design/design-audit.md + Figma AI exploration",
    "note": "这是待 Figma 评审的目标 Token，不是当前代码真相源。批准后再落回代码和 tokens.baseline.json。"
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#2D5BFF", "$description": "冷静的钴蓝；主操作、链接、选中" },
      "primaryHover": { "$type": "color", "$value": "#1F46E0" },
      "primaryPressed": { "$type": "color", "$value": "#1838B8" },
      "primarySubtle": { "$type": "color", "$value": "#EEF3FF" },
      "primaryBorder": { "$type": "color", "$value": "#C7D7FF" },
      "ai": { "$type": "color", "$value": "#0891B2", "$description": "AI 生成/自动化能力的辅助色，控制使用面积" },
      "aiSubtle": { "$type": "color", "$value": "#ECFEFF" },
      "aiBorder": { "$type": "color", "$value": "#A5F3FC" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "#F5F7FB" },
      "default": { "$type": "color", "$value": "#FFFFFF" },
      "subtle": { "$type": "color", "$value": "#F8FAFC" },
      "raised": { "$type": "color", "$value": "#FFFFFF" },
      "nav": { "$type": "color", "$value": "#0B1220" },
      "navHover": { "$type": "color", "$value": "#162033" },
      "overlay": { "$type": "color", "$value": "#0B122066" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#0F172A" },
      "secondary": { "$type": "color", "$value": "#475569" },
      "muted": { "$type": "color", "$value": "#64748B" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" },
      "nav": { "$type": "color", "$value": "#CBD5E1" },
      "navMuted": { "$type": "color", "$value": "#94A3B8" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#E2E8F0" },
      "strong": { "$type": "color", "$value": "#CBD5E1" },
      "divider": { "$type": "color", "$value": "#F1F5F9" },
      "focus": { "$type": "color", "$value": "#2D5BFF" }
    },
    "status": {
      "successFg": { "$type": "color", "$value": "#0E9F6E" },
      "successBg": { "$type": "color", "$value": "#ECFDF5" },
      "successBorder": { "$type": "color", "$value": "#A7F3D0" },
      "dangerFg": { "$type": "color", "$value": "#E11D48" },
      "dangerBg": { "$type": "color", "$value": "#FFF1F2" },
      "dangerBorder": { "$type": "color", "$value": "#FECDD3" },
      "warningFg": { "$type": "color", "$value": "#D97706" },
      "warningBg": { "$type": "color", "$value": "#FFFBEB" },
      "warningBorder": { "$type": "color", "$value": "#FDE68A" },
      "infoFg": { "$type": "color", "$value": "#2D5BFF" },
      "infoBg": { "$type": "color", "$value": "#EEF3FF" },
      "infoBorder": { "$type": "color", "$value": "#C7D7FF" },
      "neutralFg": { "$type": "color", "$value": "#475569" },
      "neutralBg": { "$type": "color", "$value": "#F1F5F9" },
      "neutralBorder": { "$type": "color", "$value": "#E2E8F0" }
    },
    "chart": {
      "cobalt": { "$type": "color", "$value": "#2D5BFF" },
      "cyan": { "$type": "color", "$value": "#0891B2" },
      "emerald": { "$type": "color", "$value": "#0E9F6E" },
      "amber": { "$type": "color", "$value": "#D97706" },
      "violet": { "$type": "color", "$value": "#7C3AED" },
      "slate": { "$type": "color", "$value": "#94A3B8" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Inter, Geist, PingFang SC, Microsoft YaHei, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "fontSize": {
      "micro": { "$type": "dimension", "$value": "11px" },
      "caption": { "$type": "dimension", "$value": "12px" },
      "table": { "$type": "dimension", "$value": "13px" },
      "body": { "$type": "dimension", "$value": "14px" },
      "title": { "$type": "dimension", "$value": "16px" },
      "h2": { "$type": "dimension", "$value": "20px" },
      "h1": { "$type": "dimension", "$value": "28px" },
      "display": { "$type": "dimension", "$value": "36px" },
      "metric": { "$type": "dimension", "$value": "28px" }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "heading": { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.65 }
    }
  },
  "dimension": {
    "space": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" }
    },
    "control": {
      "heightSm": { "$type": "dimension", "$value": "28px" },
      "heightMd": { "$type": "dimension", "$value": "32px" },
      "heightLg": { "$type": "dimension", "$value": "36px" },
      "heightXl": { "$type": "dimension", "$value": "40px" }
    },
    "layout": {
      "topbar": { "$type": "dimension", "$value": "56px" },
      "sidebar": { "$type": "dimension", "$value": "232px" },
      "contentPadding": { "$type": "dimension", "$value": "24px" },
      "contentPaddingWide": { "$type": "dimension", "$value": "32px" },
      "maxWidth": { "$type": "dimension", "$value": "1600px" },
      "cardHeader": { "$type": "dimension", "$value": "48px" },
      "tableRow": { "$type": "dimension", "$value": "48px" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "10px" },
    "xl": { "$type": "dimension", "$value": "12px" },
    "2xl": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "color": "#0F172A0A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    },
    "popover": {
      "$type": "shadow",
      "$value": { "color": "#0F172A1F", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }
    },
    "modal": {
      "$type": "shadow",
      "$value": { "color": "#0F172A2E", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" }
    },
    "focus": {
      "$type": "shadow",
      "$value": { "color": "#2D5BFF2E", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px" }
    }
  }
}
